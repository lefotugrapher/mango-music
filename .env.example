# Optional. Copy this file to .env.local and fill it in to skip the one-time
# setup step: Pane then opens straight on "Continue with Spotify".
#
# This is the Client ID of your own Spotify developer app
# (https://developer.spotify.com/dashboard). It is a public identifier, not a
# secret. Never put the Client Secret here or anywhere else in Pane.
#
# Remember that a Spotify app in development mode only admits the accounts
# listed under User Management in the dashboard (up to five).
VITE_SPOTIFY_CLIENT_ID=
